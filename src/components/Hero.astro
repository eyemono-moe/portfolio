---
import icon from "~/assets/icon-blink.svg";
import { CAREER, LINKS, SKILLS } from "~/consts";
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="name">
      <div class="met" hidden>
        <p class="bubble"><span class="met-text"></span><small class="met-date"></small></p>
      </div>
      <img class="icon" src={icon.src} alt="eyemono.moe のアイコン" />
      <h1>
        <ruby>eyemono<rt>アイモノ</rt></ruby>.<ruby>moe<rt>モエ</rt></ruby>
      </h1>
    </div>
    <div class="role">Web Engineer</div>
    <p class="intro">
      Web フロントと 3DCG に興味があります。<br />かわいくてかっこいいものが好きです。
    </p>
    <div class="blk">
      <h2>Career</h2>
      <ul class="tl">
        {
          CAREER.map(({ period, text }) => (
            <li>
              <b>{period}</b>
              {text}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="blk">
      <h2>Skills</h2>
      <ul class="chips">
        {SKILLS.map((skill) => <li class="chip">{skill}</li>)}
      </ul>
    </div>
    <div class="blk links">
      {
        LINKS.map(({ label, href }) => (
          <a href={href} target="_blank" rel="noopener noreferrer">
            {label}
          </a>
        ))
      }
    </div>
  </div>
  <a class="to-works" href="#works">
    Works を見る <span class="arrow" aria-hidden="true">↓</span>
  </a>
</section>

<script>
  import {
    STORAGE_KEY,
    parseMetAt,
    stripMetAtParams,
    toDisplayDate,
  } from "~/lib/metAt.js";

  // 最初に会ったときの記録だけを残す（別の QR から開いても上書きしない）
  const load = () => {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
    } catch {
      return null;
    }
  };
  let record = load();
  const fromUrl = parseMetAt(location.search);
  if (fromUrl) {
    if (!record) {
      record = fromUrl;
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
      } catch {}
    }
    history.replaceState(history.state, "", stripMetAtParams(location.href));
  }

  const met = document.querySelector<HTMLElement>(".met");
  if (met && typeof record?.name === "string" && typeof record?.date === "string") {
    met.querySelector(".met-text")!.textContent = `${record.name}でお会いしましたね！`;
    met.querySelector(".met-date")!.textContent = toDisplayDate(record.date);
    met.hidden = false;
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 40px 16px 96px max(16px, 6vw);
  }
  .hero-inner {
    max-width: min(520px, 44vw);
  }
  h1 {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.4;
  }
  h1 rt {
    font-size: 13px;
    font-weight: 400;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .icon {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    flex: none;
  }
  /* 「どこで会ったか」の吹き出し。揺れの支点は三角の先 */
  .met {
    --tip-x: 44px;
    flex-basis: 100%;
  }
  .bubble {
    position: relative;
    display: inline-block;
    padding: 6px 16px;
    border: 2px solid #191e1e;
    border-radius: 14px;
    background: #fff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    transform-origin: var(--tip-x) calc(100% + 10px);
    animation:
      pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s both,
      sway 3.2s ease-in-out 0.9s infinite;
  }
  .bubble small {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: #526060;
  }
  .bubble::after {
    content: "";
    position: absolute;
    /* left は枠線の内側から測られるので、transform-origin（枠線の外側基準）と揃えるため枠線ぶん戻す */
    left: calc(var(--tip-x) - 2px);
    bottom: -9px;
    width: 14px;
    height: 14px;
    border-right: 2px solid #191e1e;
    border-bottom: 2px solid #191e1e;
    background: #fff;
    transform: translateX(-50%) rotate(45deg);
  }
  /* pop は sway の始点の角度で終え、切り替わりで角度が飛ばないようにする */
  @keyframes pop {
    from {
      opacity: 0;
      transform: rotate(-1.5deg) scale(0.6);
    }
    to {
      transform: rotate(-1.5deg);
    }
  }
  @keyframes sway {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }
  .role {
    font-size: 20px;
    font-weight: 700;
    margin-top: 4px;
  }
  .intro {
    margin-top: 10px;
    font-size: 15px;
  }
  .blk {
    margin-top: 20px;
  }
  .blk h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3d4a4a;
    margin-bottom: 4px;
  }
  .tl {
    list-style: none;
    border-left: 3px solid #191e1e;
    padding-left: 12px;
    font-size: 15px;
  }
  .tl b {
    display: inline-block;
    width: 132px;
    font-weight: 700;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }
  .chip {
    font-size: 14px;
    font-weight: 700;
    padding: 1px 10px;
    border: 2px solid #191e1e;
    border-radius: 999px;
    background: #fff;
  }
  .links {
    display: flex;
    gap: 18px;
    font-weight: 700;
  }
  .links a {
    border-bottom: 2px solid #191e1e;
  }
  .to-works {
    position: absolute;
    left: max(16px, 6vw);
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px 10px 22px;
    border: 2px solid #191e1e;
    border-radius: 999px;
    background: #fff;
    color: #191e1e;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.06em;
    box-shadow: 4px 4px 0 #191e1e;
    transition:
      transform 0.12s,
      box-shadow 0.12s,
      background-color 0.12s;
  }
  .to-works:hover {
    background: #191e1e;
    color: #fff;
  }
  .to-works:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 #191e1e;
  }
  .arrow {
    display: inline-block;
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 767px) {
    /* ボタンも流れに入れて縦中央に積み、アドレスバーの分は svh で除く */
    .hero {
      flex-direction: column;
      justify-content: center;
      padding: 48px 16px 24px;
    }
    h1 {
      font-size: 32px;
    }
    h1 rt {
      font-size: 11px;
    }
    .intro {
      margin-top: 6px;
      font-size: 14px;
    }
    .blk {
      margin-top: 14px;
    }
    .tl {
      font-size: 14px;
    }
    .tl b {
      width: 8.4em;
    }
    .hero-inner {
      margin: 0 auto;
      width: 100%;
      max-width: 420px;
    }
    .name {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
    .met {
      --tip-x: 50%;
      margin-bottom: 6px;
    }
    .bubble::after {
      left: 50%;
    }
    .bubble {
      font-size: 13px;
    }
    .bubble small {
      font-size: 11px;
    }
    /* 吹き出しのぶん縦に伸びるので、1画面に収まるよう上の余白とアイコンを小さくする */
    .hero:has(.met:not([hidden])) {
      padding-top: 20px;
    }
    .name:has(.met:not([hidden])) .icon {
      width: min(24vw, 96px);
    }
    .icon {
      width: min(30vw, 120px);
      height: auto;
      aspect-ratio: 1;
      border-width: 4px;
    }
    .role,
    .intro {
      text-align: center;
    }
    .links {
      justify-content: center;
    }
    .to-works {
      position: static;
      margin-top: 20px;
    }
  }
  /* ごく狭い幅では期間と所属を横に並べると途中で折り返すので縦に積む */
  @media (max-width: 359px) {
    .tl b {
      display: block;
      width: auto;
    }
    .tl li + li {
      margin-top: 4px;
    }
  }
</style>

---
import Base from "~/layouts/Base.astro";
---

<Base title="Not Found">
  <script is:inline>
    location.replace("/");
  </script>
  <div class="not-found mx-a max-w-1024px px-4 prose prose-black">
    <h1>Page Not Found</h1>
    <p><a href="/">トップページへ</a></p>
  </div>
</Base>

<style>
  .not-found {
    padding-top: calc(var(--hdr-l) + 32px);
    padding-bottom: 64px;
  }
</style>
